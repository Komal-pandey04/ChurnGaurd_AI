# Copy to .env and adjust as needed. No secrets are required to run the
# core platform -- there are no external API keys, since the ML pipeline
# runs entirely locally on the bundled dataset.

# Comma-separated list of origins allowed to call the API.
CHURNGUARD_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Override where the SQLite database lives (defaults to backend/data/churnguard.db).
CHURNGUARD_DB_PATH=

# --- Optional / future integrations (not required to run the app) ---
# If you later plug in Azure ML or Azure Blob Storage for artifact storage,
# put credentials here -- never commit real values.
AZURE_ML_WORKSPACE=
AZURE_ML_SUBSCRIPTION_ID=
AZURE_STORAGE_CONNECTION_STRING=

# If you later add a Postgres backend instead of SQLite for multi-user
# deployment, set this and update app/core/db.py accordingly.
DATABASE_URL=
